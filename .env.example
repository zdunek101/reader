# Frontend (Vite) — adres backendu (Cloudflare Worker). Lokalnie: wynik `npm run worker:dev`.
VITE_API_URL=http://localhost:8787

# Backend (Cloudflare Worker) — lokalnie wpisz do pliku .dev.vars (nadpisuje [vars] z wrangler.toml).
ALLOWED_ORIGINS=http://localhost:5173

# Backend — lokalnie w .dev.vars, produkcyjnie: `npx wrangler secret put GEMINI_API_KEY`.
# Nigdy nie commituj prawdziwego klucza.
GEMINI_API_KEY=
